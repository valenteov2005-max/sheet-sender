PORT=3005

# Gmail account used to send the spreadsheets.
# Generate an app password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Name shown as the sender on outgoing emails
FROM_NAME=LEADS TFC

# Set to true to save spreadsheets to data/ instead of emailing them (for testing)
DRY_RUN=false
