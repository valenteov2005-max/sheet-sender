PORT=3005

# Email account that sends the spreadsheets (SMTP).
# GoDaddy Workspace Email: SMTP_HOST=smtpout.secureserver.net  SMTP_PORT=465
# Microsoft 365 from GoDaddy: SMTP_HOST=smtp.office365.com     SMTP_PORT=587
# Gmail (app password):       SMTP_HOST=smtp.gmail.com         SMTP_PORT=465
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-email-password

# Name shown as the sender on outgoing emails
FROM_NAME=LEADS TFC

# Google account that owns the created sheets (see README: "Google setup").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Set to true to skip creating sheets and sending emails (for testing)
DRY_RUN=false
